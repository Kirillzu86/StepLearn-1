# Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
JWT_SECRET=replace-with-a-different-long-random-jwt-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
# Для работы через PostgreSQL задайте реальные локальные реквизиты:
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=Stepik
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Для тестов/локальной разработки без Postgres можно включить SQLite:
# USE_SQLITE=1

# CORS
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

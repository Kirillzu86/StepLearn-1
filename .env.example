# Docker Compose settings (copy to .env in the repository root)
POSTGRES_USER=steplearn
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=steplearn

DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
JWT_SECRET=replace-with-a-different-long-random-jwt-secret
DJANGO_DEBUG=0
SEED_DEMO_DATA=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:3001
VITE_API_URL=
VITE_TEACHER_APP_URL=http://localhost:3001
TEACHER_FRONTEND_PORT=3001

# Set these when the isolated runner is deployed on its own host/VM.
CODE_RUNNER_URL=https://runner.example.internal
CODE_RUNNER_TOKEN=replace-with-a-long-random-runner-token
